def clean_text(v):
    x=html.unescape(str(v or '')); x=re.sub(r'[®™©℠]','',x); return re.sub(r'\s+',' ',x).strip(' \t\r\n|•·—–-:;,')

def norm(v):
    x=unicodedata.normalize('NFKD',clean_text(v)).encode('ascii','ignore').decode().casefold().replace('&',' and ')
    return re.sub(r'\s+',' ',re.sub(r'[^a-z0-9]+',' ',x)).strip()

def clean_image_name(v):
    x=clean_text(v).replace('_',' ')
    x=re.sub(r'(?i)^client logos?\s*(?:website\s*)?','',x)
    x=re.sub(r'(?i)\.(?:png|jpe?g|webp|svg)$','',x)
    for _ in range(4):
        old=x
        x=re.sub(r'(?i)\s*(?:[-–—_:]?\s*(?:logos?|wordmark|brandmark|icon|grid portrait|portrait|primary|secondary|white|black|rgb|cmyk|copy|core|final|transparent))(?:[-–—_ ]*\d+)?\s*$','',x).strip()
        x=re.sub(r'(?i)\s+\d{2,4}x\d{2,4}(?:\s+v?\d+(?:\.\d+)?)?\s*$','',x).strip()
        if x==old: break
    return clean_text(x)

def parse_obj(v):
    try:
        x=json.loads(v or '')
        return x if isinstance(x,dict) else None
    except Exception:
        return None

def noise_name(v,obj=None):
    x=clean_text(v); n=norm(x)
    if not n or len(x)<2 or len(x)>150 or len(x.split())>14 or sum(ch.isalpha() for ch in x)<2: return True
    if n in GENERIC_EXACT or n in COUNTRY_NAMES or n in CATEGORY_LABELS: return True
    if any(t in x.casefold() for t in GENERIC_SUBSTR): return True
    if re.match(r'(?i)^(flag_|color_|colour_|font_|page_|wix|icon_|btn_|button_|section_|component_)',x): return True
    if re.match(r'(?i)^[a-z]+_[a-z0-9_]+$',x): return True
    if re.match(r'(?i)^(https?://|www\.|mailto:|tel:)',x): return True
    if ARTICLE_RE.search(x) and len(x.split())>=5: return True
    if re.search(r'(?i)\b(20\d{2}|million|billion|award|finalist|viewership|youtube channels|territories)\b',x) and len(x.split())>=5: return True
    if re.search(r'[.!?]',x) and len(x.split())>=8: return True
    if obj:
        keys=set(obj)
        if {'code','phoneCode'} <= keys or {'fontFamily','provider'} <= keys or {'reference','value'} <= keys: return True
        if {'clientSlugs','key','title'} <= keys or 'catalogue_entry_id' in keys: return True
        if any(k in keys for k in ('pageUriSEO','pageJsonFileName','isHomePage','defaultPage')): return True
        if {'category','clientName','date','slug','title'} <= keys: return True
        if 'clientName' in keys and ('year' in keys or 'categories' in keys): return True
