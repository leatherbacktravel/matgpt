  folder=RAW/re.sub(r'[^a-z0-9]+','-',s['name'].casefold()).strip('-')[:70]; folder.mkdir(parents=True,exist_ok=True); path=folder/(digest+'.html.gz'); gzip.open(path,'wt',encoding='utf-8').write(p['html']); raw=str(path.relative_to(ROOT))
 text=clean(BeautifulSoup(p['html'] or '','lxml').get_text(' ',strip=True))[:3000]
 return c.execute('INSERT INTO pages(source_id,requested_url,final_url,title,http_status,content_type,fetch_method,fetched_at,elapsed_ms,content_hash,text_excerpt,raw_path,error) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)',(s['id'],p['requested'],p['final'],p['title'],p['status'],p['ctype'],p['method'],NOW,p['ms'],digest,text,raw,p['error'])).lastrowid
