 threshold=.58 if s['source_type'].startswith('conference') else .62
 if e['confidence']<threshold:return 0
 if e['type']=='licensing_agency':
  cid=company(c,e['name'],'licensing_agency',s,e['link'],e['context']);evidence(c,s,pid,'company',cid,'industry_agent_listing',e,source_url)
 elif s['source_type']=='agency_portfolio' or e['parent']:
