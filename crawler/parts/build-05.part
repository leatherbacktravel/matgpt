 return out
def links(page,seed):
 soup=BeautifulSoup(page['html'] or '','lxml'); scores={}
 for a in soup.select('a[href]')[:10000]:
  href=a.get('href',''); text=clean(a.get_text(' ',strip=True)); signal=href+' '+text
  if not href or EXCL.search(signal):continue
  u=url(href,page['final'])
  if not u or not same(seed,u) or (not SIG.search(signal) and not re.search(r'(?i)(page=|/page/|pagination|next)',signal)):continue
  score=1+4*bool(re.search(r'(?i)(brand|client|portfolio|property|roster)',signal))+2*bool(re.search(r'(?i)licen[cs]',signal));scores[u]=max(scores.get(u,0),score)
 return [x for x,_ in sorted(scores.items(),key=lambda z:(-z[1],z[0]))[:20]]
def insert_page(c,s,p):
