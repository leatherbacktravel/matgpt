  c.execute('INSERT OR IGNORE INTO representations(agency_company_id,brand_id,source_id,page_id,source_url,brand_url,territory,relationship_status,extraction_method,confidence,context,observed_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)',(aid,bid,s['id'],pid,source_url,e['link'],s.get('region',''),e['relationship'] or 'portfolio_presence_unverified',e['method'],e['confidence'],e['context'],NOW))
 elif s['source_type'].startswith('conference'):
  cid=company(c,e['name'],'conference_exhibitor_or_licensor',s,e['link'],e['context']);c.execute('INSERT INTO conference_presence(source_id,page_id,conference_name,edition_year,entity_type,company_id,source_url,linked_url,extraction_method,confidence,context,observed_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)',(s['id'],pid,s['name'],2026,'company',cid,source_url,e['link'],e['method'],e['confidence'],e['context'],NOW));evidence(c,s,pid,'company',cid,'conference_directory_presence',e,source_url)
 else:
  cid=company(c,e['name'],'licensing_market_participant',s,e['link'],e['context']);evidence(c,s,pid,'company',cid,'industry_directory_presence',e,source_url)
 c.execute('UPDATE raw_extractions SET promoted=1 WHERE id=?',(raw,));return 1
def process(c,s,p,agency_id):
 pid=insert_page(c,s,p)
 if not p['html'] or p['status']>=400 or p['status']==0:return 0,0,[]
 ex=extract_lg(p) if s['parser']=='licenseglobal_agents' or 'top-global-licensing-agents' in p['final'] else extract_generic(p); promoted=0
 for e in ex:
  try:promoted+=promote(c,s,pid,e,p['final'],agency_id)
  except:pass
 return len(ex),promoted,links(p,s['crawl_url'] or s['base_url'])
