  u=q.popleft()
  if not u or u in seen:continue
  seen.add(u);p=await asyncio.to_thread(static,u,session);rb=p['robots'];statuses.append(p['status']);final=p['final'] or final;r,x,more=process(c,s,p,agency_id);raw+=r;prom+=x
  textlen=len(BeautifulSoup(p['html'] or '','lxml').get_text(' ',strip=True));need=s['access_mode']=='public_js' or s['parser'] in ('eventware','browser_portfolio') or ((p['status']==0 or p['status']>=400 or r<2) and (s['priority']<=2 or textlen<1500 or '__NEXT_DATA__' in (p['html'] or '')))
  if need:
   async with sem:bp=await browser(u,int(s['config'].get('scroll_rounds') or 14))
   bused=True
   if bp['html'] and bp['status']:
    r,x,m=process(c,s,bp,agency_id);raw+=r;prom+=x;more+=m;statuses.append(bp['status']);final=bp['final'] or final
   elif bp['error']:errs.append('browser '+bp['error'][:220])
  if p['error']:errs.append('static '+p['error'][:220])
  for x in more:
   if x not in seen and x not in queued and len(queued)<maxp*8:q.append(x);queued.add(x)
  c.commit();await asyncio.sleep(.2)
 good=c.execute('SELECT count(*) FROM pages WHERE source_id=? AND http_status BETWEEN 200 AND 399',(s['id'],)).fetchone()[0];status='complete' if good else 'failed';ms=int((time.monotonic()-start)*1000)
 c.execute('UPDATE sources SET status=?,http_status=?,final_url=?,robots_status=?,pages_fetched=?,raw_candidates=?,promoted_entities=?,finished_at=?,elapsed_ms=?,error=? WHERE id=?',(status,next((x for x in statuses if x),0),final,rb,len(seen),raw,prom,NOW,ms,' | '.join(errs[:10]),s['id']));c.commit();return {'source':s['name'],'status':status,'pages':len(seen),'raw':raw,'promoted':prom,'browser':bused,'error':' | '.join(errs[:5])}
def dump(c,query):return [dict(x) for x in c.execute(query).fetchall()]
def write(name,obj): (OUT/name).parent.mkdir(parents=True,exist_ok=True);(OUT/name).write_text(json.dumps(obj,ensure_ascii=False,separators=(',',':')),encoding='utf-8')
def exports(c,results):
 c.execute("UPDATE companies SET evidence_count=(SELECT count(*) FROM evidence e WHERE e.subject_type='company' AND e.subject_id=companies.id)")
 c.execute("UPDATE brands SET evidence_count=(SELECT count(*) FROM evidence e WHERE e.subject_type='brand' AND e.subject_id=brands.id),representation_count=(SELECT count(DISTINCT agency_company_id) FROM representations r WHERE r.brand_id=brands.id),conference_count=(SELECT count(*) FROM conference_presence p WHERE p.brand_id=brands.id)")
 for r in c.execute('SELECT id,category,evidence_count,representation_count,conference_count FROM brands').fetchall():
  fit=TRAVEL.get(r['category'] or 'other',58);ready=min(95,38+r['evidence_count']*8+r['representation_count']*15+r['conference_count']*10);score=round(fit*.58+ready*.42,1);c.execute('UPDATE brands SET travel_fit_score=?,licensing_readiness_score=?,preliminary_score=? WHERE id=?',(fit,ready,score,r['id']))
 c.commit();status=dict(c.execute('SELECT status,count(*) FROM sources GROUP BY status').fetchall());m={'generated_at':NOW,'registered_sources':c.execute('SELECT count(*) FROM sources').fetchone()[0],'sources_complete':c.execute("SELECT count(*) FROM sources WHERE status='complete'").fetchone()[0],'sources_failed':c.execute("SELECT count(*) FROM sources WHERE status='failed'").fetchone()[0],'sources_skipped_gated':c.execute("SELECT count(*) FROM sources WHERE status='skipped_gated'").fetchone()[0],'pages_captured':c.execute('SELECT count(*) FROM pages').fetchone()[0],'licensing_agencies':c.execute("SELECT count(*) FROM companies WHERE company_type='licensing_agency'").fetchone()[0],'market_participants':c.execute('SELECT count(*) FROM companies').fetchone()[0],'brands_or_properties':c.execute('SELECT count(*) FROM brands').fetchone()[0],'agency_brand_relationships':c.execute('SELECT count(*) FROM representations').fetchone()[0],'conference_presences':c.execute('SELECT count(*) FROM conference_presence').fetchone()[0],'evidence_records':c.execute('SELECT count(*) FROM evidence').fetchone()[0],'raw_extractions':c.execute('SELECT count(*) FROM raw_extractions').fetchone()[0],'source_status_counts':status,'scope':'Public agencies, portfolios, industry reports and conference directories in the registered global source universe.','completeness_caveat':'Auditable discovery database; failed and gated sources remain visible. It does not claim an impossible mathematically complete census.','ranking_status':'preliminary_heuristic_only'}
 write('metadata.json',m);write('sources.json',dump(c,'SELECT * FROM sources ORDER BY priority,id'));write('agencies.json',dump(c,"SELECT c.*,(SELECT count(DISTINCT r.brand_id) FROM representations r WHERE r.agency_company_id=c.id) represented_brand_count FROM companies c WHERE c.company_type='licensing_agency' ORDER BY represented_brand_count DESC,c.canonical_name"));write('companies.json',dump(c,'SELECT * FROM companies ORDER BY company_type,canonical_name'));write('brands.json',dump(c,'SELECT * FROM brands ORDER BY preliminary_score DESC,canonical_name'));write('representations.json',dump(c,'SELECT r.*,a.canonical_name agency_name,b.canonical_name brand_name,b.category,b.preliminary_score FROM representations r JOIN companies a ON a.id=r.agency_company_id JOIN brands b ON b.id=r.brand_id ORDER BY agency_name,brand_name'));write('conference_presence.json',dump(c,'SELECT p.*,c.canonical_name company_name,b.canonical_name brand_name FROM conference_presence p LEFT JOIN companies c ON c.id=p.company_id LEFT JOIN brands b ON b.id=p.brand_id ORDER BY p.conference_name,COALESCE(c.canonical_name,b.canonical_name)'));write('crawl_results.json',results)
 queue=dump(c,"SELECT b.id,b.canonical_name,b.website,b.category,b.description,b.evidence_count,b.representation_count,b.travel_fit_score,b.licensing_readiness_score,b.preliminary_score,GROUP_CONCAT(DISTINCT a.canonical_name) agencies FROM brands b LEFT JOIN representations r ON r.brand_id=b.id LEFT JOIN companies a ON a.id=r.agency_company_id GROUP BY b.id ORDER BY b.preliminary_score DESC,b.evidence_count DESC,b.canonical_name LIMIT 1000");write('analysis_queue.json',queue)
 for i in range(0,len(queue),100):write(Path('analysis_chunks')/f'chunk-{i//100+1:02d}.json',queue[i:i+100])
 for fn,q in {'agencies.csv':"SELECT c.*,(SELECT count(DISTINCT r.brand_id) FROM representations r WHERE r.agency_company_id=c.id) represented_brand_count FROM companies c WHERE c.company_type='licensing_agency' ORDER BY represented_brand_count DESC,c.canonical_name",'brands.csv':'SELECT * FROM brands ORDER BY preliminary_score DESC,canonical_name','representations.csv':'SELECT r.id,a.canonical_name agency,b.canonical_name brand,r.source_url,r.brand_url,r.relationship_status,r.extraction_method,r.confidence,r.context,r.observed_at FROM representations r JOIN companies a ON a.id=r.agency_company_id JOIN brands b ON b.id=r.brand_id ORDER BY agency,brand','sources.csv':'SELECT * FROM sources ORDER BY priority,id'}.items():
  rr=c.execute(q).fetchall();f=open(OUT/fn,'w',newline='',encoding='utf-8');
  if rr:w=csv.DictWriter(f,fieldnames=rr[0].keys());w.writeheader();w.writerows([dict(x) for x in rr])
  f.close()
 failures=dump(c,"SELECT name,source_type,crawl_url,http_status,robots_status,error FROM sources WHERE status!='complete' ORDER BY priority,id");lines=['# Leatherback Licensing Database — Crawl Report','',f'Generated: `{NOW}`','','## Counts','']+[f"- **{k.replace('_',' ').title()}**: {v}" for k,v in m.items() if isinstance(v,(int,float))]+['','## Sources not completed','','| Source | Type | HTTP | Robots | Error |','|---|---|---:|---|---|']+[f"| {x['name']} | {x['source_type']} | {x['http_status'] or ''} | {x['robots_status'] or ''} | {(x['error'] or '')[:220].replace('|','/')} |" for x in failures];(OUT/'CRAWL_REPORT.md').write_text('\n'.join(lines),encoding='utf-8');return m
async def main():
 ap=argparse.ArgumentParser();ap.add_argument('--limit',type=int,default=0);ap.add_argument('--concurrency',type=int,default=4);ap.add_argument('--browser-concurrency',type=int,default=1);a=ap.parse_args();src=rows();src=src[:a.limit] if a.limit else src;c=init();c.executemany('INSERT INTO sources(id,name,source_type,agency_name,region,country,focus,priority,official,access_mode,parser,base_url,crawl_url,notes) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)',[(s['id'],s['name'],s['source_type'],s.get('agency_name',''),s.get('region',''),s.get('country',''),s.get('focus',''),s['priority'],int(s['official']),s.get('access_mode','public'),s.get('parser','generic_portfolio'),s.get('base_url',''),s.get('crawl_url',''),s.get('notes','')) for s in src]);c.commit();sem=asyncio.Semaphore(a.browser_concurrency);gate=asyncio.Semaphore(a.concurrency)
 async def one(s):
  async with gate:
   print('[START]',s['id'],s['name'],flush=True)
   try:r=await crawl(c,s,sem)
   except Exception as x:r={'source':s['name'],'status':'failed','error':f'{type(x).__name__}: {x}'};c.execute("UPDATE sources SET status='failed',finished_at=?,error=? WHERE id=?",(NOW,r['error'],s['id']));c.commit()
   print('[DONE]',s['id'],s['name'],r.get('status'),'raw',r.get('raw',0),'promoted',r.get('promoted',0),flush=True);return r
 results=[]
 for t in asyncio.as_completed([asyncio.create_task(one(s)) for s in sorted(src,key=lambda x:(x['priority'],x['id']))]):results.append(await t)
 print(json.dumps(exports(c,results),indent=2));c.close()
if __name__=='__main__':asyncio.run(main())
